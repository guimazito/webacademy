// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/*
https://www.prisma.io/docs/getting-started/setup-prisma/start-from-scratch/relational-databases/using-prisma-migrate-typescript-mysql

https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/one-to-many-relations

https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/many-to-many-relations

https://www.prisma.io/docs/orm/prisma-client/queries/crud
*/

model Cliente {
  cpfCliente     String     @id
  nome           String     @db.VarChar(45)
  celular        String     @db.VarChar(45)
  email          String     @db.VarChar(45)
  dataNascimento DateTime   @db.Date
  endereco       Endereco[]
  compras        Compra[]
}

model Endereco {
  idEndereco   Int      @id @default(autoincrement())
  cpfCliente   String
  cep          String   @db.VarChar(45)
  bairro       String   @db.VarChar(45)
  cidade       String   @db.VarChar(45)
  numero       String   @db.VarChar(45)
  logradouro   String   @db.VarChar(45)
  complemento  String?  @db.VarChar(45)
  cliente      Cliente  @relation(fields: [cpfCliente], references: [cpfCliente])
  compras      Compra[]
}

model Produto {
  idProduto             Int           @id @default(autoincrement())
  idSubcategoria        Int
  modelo                String        @db.VarChar(45)
  fabricante            String        @db.VarChar(45)
  precoBase             Float
  quantidadeDisponivel  Int           
  subcategoria          Subcategoria  @relation(fields: [idSubcategoria], references: [idSubcategoria])
  numerosSerie          NumeroSerie[]
  itensCompra           ItemCompra[]
}

model Categoria {
  idCategoria   Int           @id @default(autoincrement())
  nome          String        @db.VarChar(45)
  subcategorias Subcategoria[]
}

model Subcategoria {
  idSubcategoria  Int         @id @default(autoincrement())
  idCategoria     Int
  nome            String      @db.VarChar(45)
  categoria       Categoria   @relation(fields: [idCategoria], references: [idCategoria])
  produtos        Produto[]
}

model NumeroSerie {
  idNumeroSerie  Int      @id @default(autoincrement())
  idProduto      Int
  numeroSerie    String   @db.VarChar(45)
  produto        Produto  @relation(fields: [idProduto], references: [idProduto])
}

model Compra {
  idCompra        Int       @id @default(autoincrement())
  cpfCliente      String
  idEndereco      Int
  dataHora        DateTime  @db.DateTime
  formaPagamento  String    @db.VarChar(45)
  total           Float
  desconto        Float?
  cliente         Cliente   @relation(fields: [cpfCliente], references: [cpfCliente])
  endereco        Endereco  @relation(fields: [idEndereco], references: [idEndereco])
  itens           ItemCompra[]
}

model ItemCompra {
  idItemCompra   Int      @id @default(autoincrement())
  idCompra       Int
  idProduto      Int
  precoUnitario  Float
  quantidade     Int
  compra         Compra   @relation(fields: [idCompra], references: [idCompra])
  produto        Produto  @relation(fields: [idProduto], references: [idProduto])
}

